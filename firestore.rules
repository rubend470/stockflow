rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && userDoc(request.auth.uid).role == 'super_admin';
    }

    function isAdminOrAbove() {
      return isSignedIn() && userDoc(request.auth.uid).role in ['super_admin', 'admin'];
    }

    function hasAssignedMenuPermission(permission) {
      return isSignedIn()
        && userDoc(request.auth.uid).menuPermissions is list
        && permission in userDoc(request.auth.uid).menuPermissions;
    }

    function hasLegacyDefaultMenuPermission(permission) {
      return isSignedIn()
        && !(userDoc(request.auth.uid).menuPermissions is list)
        && (
          (
            userDoc(request.auth.uid).role == 'admin'
            && permission in [
              'home',
              'pos',
              'currency-exchange',
              'client-debts',
              'sales-history',
              'cash-closing',
              'reports',
              'products',
              'categories',
              'product-types',
              'offers',
              'add-product',
              'pending-invoices',
              'suppliers',
              'expenses',
              'currencies',
              'payments',
              'settings',
              'keyboard-shortcuts'
            ]
          )
          || (
            userDoc(request.auth.uid).role == 'cashier'
            && permission in [
              'home',
              'pos',
              'currency-exchange',
              'client-debts',
              'sales-history'
            ]
          )
        );
    }

    function hasMenuPermission(permission) {
      return isSuperAdmin()
        || hasAssignedMenuPermission(permission)
        || hasLegacyDefaultMenuPermission(permission);
    }

    function hasLegacyOperationalAccess() {
      return isAdminOrAbove()
        || hasMenuPermission('pos')
        || hasMenuPermission('client-debts')
        || hasMenuPermission('pending-invoices')
        || hasMenuPermission('suppliers')
        || hasMenuPermission('categories')
        || hasMenuPermission('waste');
    }

    function hasAdminPermission() {
      return isSuperAdmin()
        || hasMenuPermission('users')
        || hasMenuPermission('settings');
    }

    function validRole(role) {
      return role in ['super_admin', 'admin', 'cashier'];
    }

    function isBusinessMember(businessId) {
      return isSignedIn()
        && userDoc(request.auth.uid).businessIds is list
        && businessId in userDoc(request.auth.uid).businessIds;
    }

    function canCreateTenantDocument(collectionId) {
      return (
        (collectionId == 'products' && hasMenuPermission('add-product'))
        || (collectionId == 'stock_categories' && hasMenuPermission('categories'))
        || (collectionId in ['currencies', 'exchange_rates'] && hasMenuPermission('currencies'))
        || (collectionId == 'currency_exchange_rates' && (hasMenuPermission('currency-exchange') || hasMenuPermission('currencies')))
        || (collectionId == 'payment_methods' && hasMenuPermission('payments'))
        || (collectionId == 'currency_exchanges' && hasMenuPermission('currency-exchange'))
        || (collectionId == 'expenses' && hasMenuPermission('expenses'))
        || (collectionId == 'offers' && hasMenuPermission('offers'))
        || (collectionId == 'product_types' && hasMenuPermission('product-types'))
        || (collectionId == 'keyboard_shortcuts' && hasMenuPermission('keyboard-shortcuts'))
        || (collectionId == 'cash_movements' && (hasMenuPermission('cash-movements') || hasMenuPermission('cash-opening') || hasMenuPermission('cash-closing')))
        || (collectionId == 'inventory_movements' && hasLegacyOperationalAccess())
        || (collectionId == 'settings' && hasMenuPermission('settings'))
        || (collectionId == 'clients' && (hasMenuPermission('client-debts') || hasMenuPermission('pos')))
        || (collectionId == 'suppliers' && (hasMenuPermission('suppliers') || hasMenuPermission('pending-invoices')))
        || (collectionId == 'cash_sessions' && (hasMenuPermission('pos') || hasMenuPermission('cash-closing')))
        || (collectionId == 'cash_closures' && hasMenuPermission('cash-closing'))
        || (collectionId == 'debts' && (hasMenuPermission('client-debts') || hasMenuPermission('pos')))
        || (collectionId == 'debt_payments' && hasMenuPermission('client-debts'))
        || (collectionId in ['loans', 'loan_payments'] && hasMenuPermission('client-debts'))
        || (collectionId == 'purchase_invoices' && (hasMenuPermission('pending-invoices') || hasMenuPermission('suppliers')))
        || (collectionId == 'sales' && hasMenuPermission('pos'))
      );
    }

    function canUpdateTenantDocument(collectionId) {
      return (
        (collectionId == 'products' && (hasMenuPermission('add-product') || hasMenuPermission('pending-invoices') || hasMenuPermission('suppliers') || (hasLegacyOperationalAccess() && isStockOnlyUpdate())))
        || (collectionId == 'stock_categories' && (hasMenuPermission('categories') || hasMenuPermission('pending-invoices') || hasMenuPermission('suppliers') || (hasLegacyOperationalAccess() && isStockOnlyUpdate())))
        || (collectionId in ['currencies', 'exchange_rates'] && hasMenuPermission('currencies'))
        || (collectionId == 'currency_exchange_rates' && (hasMenuPermission('currency-exchange') || hasMenuPermission('currencies')))
        || (collectionId == 'payment_methods' && hasMenuPermission('payments'))
        || (collectionId == 'currency_exchanges' && (hasMenuPermission('currencies') || hasMenuPermission('payments')))
        || (collectionId == 'expenses' && hasMenuPermission('expenses'))
        || (collectionId == 'offers' && hasMenuPermission('offers'))
        || (collectionId == 'product_types' && hasMenuPermission('product-types'))
        || (collectionId == 'keyboard_shortcuts' && hasMenuPermission('keyboard-shortcuts'))
        || (collectionId == 'cash_movements' && (hasMenuPermission('cash-movements') || hasMenuPermission('cash-opening') || hasMenuPermission('cash-closing')))
        || (collectionId == 'inventory_movements' && hasAdminPermission())
        || (collectionId == 'settings' && hasMenuPermission('settings'))
        || (collectionId == 'clients' && (hasMenuPermission('client-debts') || hasMenuPermission('pos')))
        || (collectionId == 'suppliers' && (hasMenuPermission('suppliers') || hasMenuPermission('pending-invoices')))
        || (collectionId == 'cash_sessions' && (hasMenuPermission('pos') || hasMenuPermission('cash-closing')))
        || (collectionId == 'cash_closures' && hasAdminPermission())
        || (collectionId == 'debts' && hasMenuPermission('client-debts'))
        || (collectionId in ['debt_payments', 'loan_payments'] && hasAdminPermission())
        || (collectionId == 'loans' && hasMenuPermission('client-debts'))
        || (collectionId == 'purchase_invoices' && (hasMenuPermission('pending-invoices') || hasMenuPermission('suppliers')))
        || (collectionId == 'sales' && (hasMenuPermission('sales-history') || hasMenuPermission('pos')))
      );
    }

    function canDeleteTenantDocument(collectionId) {
      return (
        (collectionId == 'products' && hasMenuPermission('add-product'))
        || (collectionId == 'stock_categories' && hasMenuPermission('categories'))
        || (collectionId in ['currencies', 'exchange_rates'] && hasMenuPermission('currencies'))
        || (collectionId == 'currency_exchange_rates' && (hasMenuPermission('currency-exchange') || hasMenuPermission('currencies')))
        || (collectionId == 'payment_methods' && hasMenuPermission('payments'))
        || (collectionId == 'currency_exchanges' && (hasMenuPermission('currencies') || hasMenuPermission('payments')))
        || (collectionId == 'expenses' && hasMenuPermission('expenses'))
        || (collectionId == 'offers' && hasMenuPermission('offers'))
        || (collectionId == 'product_types' && hasMenuPermission('product-types'))
        || (collectionId == 'keyboard_shortcuts' && hasMenuPermission('keyboard-shortcuts'))
        || (collectionId == 'cash_movements' && (hasMenuPermission('cash-movements') || hasMenuPermission('cash-opening') || hasMenuPermission('cash-closing')))
        || (collectionId == 'inventory_movements' && (hasAdminPermission() || hasMenuPermission('waste')))
        || (collectionId == 'settings' && hasMenuPermission('settings'))
        || (collectionId == 'clients' && hasMenuPermission('client-debts'))
        || (collectionId == 'suppliers' && hasMenuPermission('suppliers'))
        || (collectionId in ['cash_sessions', 'cash_closures', 'debts', 'debt_payments', 'loans', 'loan_payments', 'purchase_invoices', 'sales'] && hasAdminPermission())
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && validRole(request.resource.data.role)
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'active', 'createdAt'])
        && (
          request.auth.uid == userId
          || isSuperAdmin()
        );

      allow update: if hasMenuPermission('users')
        || (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active
          && request.resource.data.menuPermissions == resource.data.menuPermissions
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt'])
        )
        || (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['presence', 'updatedAt'])
        )
        || (
          request.auth.uid == userId
          && request.resource.data.businessIds == resource.data.businessIds
          && request.resource.data.currentBusinessId in resource.data.businessIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBusinessId', 'updatedAt'])
        );

      allow delete: if hasMenuPermission('users');
    }

    function isStockOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']);
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, delete: if hasMenuPermission('add-product');
      allow update: if hasMenuPermission('add-product')
        || hasMenuPermission('pending-invoices')
        || hasMenuPermission('suppliers')
        || (hasLegacyOperationalAccess() && isStockOnlyUpdate());
    }

    match /stock_categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, delete: if hasMenuPermission('categories');
      allow update: if hasMenuPermission('categories')
        || hasMenuPermission('pending-invoices')
        || hasMenuPermission('suppliers')
        || (hasLegacyOperationalAccess() && isStockOnlyUpdate());
    }

    match /currencies/{currencyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasMenuPermission('currencies');
    }

    match /exchange_rates/{rateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasMenuPermission('currencies');
    }

    match /currency_exchange_rates/{rateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasMenuPermission('currency-exchange') || hasMenuPermission('currencies');
    }

    match /payment_methods/{methodId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasMenuPermission('payments');
    }

    match /currency_exchanges/{exchangeId} {
      allow read: if isSignedIn();
      allow create: if hasMenuPermission('currency-exchange');
      allow update, delete: if hasMenuPermission('currencies') || hasMenuPermission('payments');
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasMenuPermission('expenses');
    }

    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasMenuPermission('offers');
    }

    match /product_types/{typeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasMenuPermission('product-types');
    }

    match /keyboard_shortcuts/{shortcutId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasMenuPermission('keyboard-shortcuts');
    }

    match /cash_movements/{movementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasMenuPermission('cash-movements')
        || hasMenuPermission('cash-opening')
        || hasMenuPermission('cash-closing');
    }

    match /inventory_movements/{movementId} {
      allow read: if isSignedIn();
      allow create: if hasLegacyOperationalAccess();
      allow update: if hasAdminPermission();
      allow delete: if hasAdminPermission() || hasMenuPermission('waste');
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasMenuPermission('settings');
    }

    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update: if hasMenuPermission('client-debts') || hasMenuPermission('pos');
      allow delete: if hasMenuPermission('client-debts');
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update: if hasMenuPermission('suppliers') || hasMenuPermission('pending-invoices');
      allow delete: if hasMenuPermission('suppliers');
    }

    match /cash_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if hasMenuPermission('pos') || hasMenuPermission('cash-closing');
      allow delete: if hasAdminPermission();
    }

    match /cash_closures/{closureId} {
      allow read: if isSignedIn();
      allow create: if hasMenuPermission('cash-closing');
      allow update, delete: if hasAdminPermission();
    }

    match /debts/{debtId} {
      allow read: if isSignedIn();
      allow create: if hasMenuPermission('client-debts') || hasMenuPermission('pos');
      allow update: if hasMenuPermission('client-debts');
      allow delete: if hasAdminPermission();
    }

    match /debt_payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if hasMenuPermission('client-debts');
      allow update, delete: if hasAdminPermission();
    }

    match /loans/{loanId} {
      allow read: if isSignedIn();
      allow create, update: if hasMenuPermission('client-debts');
      allow delete: if hasAdminPermission();
    }

    match /loan_payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if hasMenuPermission('client-debts');
      allow update, delete: if hasAdminPermission();
    }

    match /purchase_invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create, update: if hasMenuPermission('pending-invoices') || hasMenuPermission('suppliers');
      allow delete: if hasAdminPermission();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if hasMenuPermission('pos');
      allow update: if hasMenuPermission('sales-history') || hasMenuPermission('pos');
      allow delete: if hasAdminPermission();

      match /items/{itemId} {
        allow read: if isSignedIn();
        allow create: if hasMenuPermission('pos');
        allow update, delete: if hasAdminPermission();
      }

      match /payments/{paymentId} {
        allow read: if isSignedIn();
        allow create: if hasMenuPermission('pos') || hasMenuPermission('client-debts');
        allow update, delete: if hasAdminPermission();
      }
    }

    match /businesses/{businessId} {
      allow read: if isBusinessMember(businessId) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isBusinessMember(businessId) && hasAdminPermission();
      allow delete: if false;

      match /{collectionId}/{documentId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessMember(businessId) && canCreateTenantDocument(collectionId);
        allow update: if isBusinessMember(businessId) && canUpdateTenantDocument(collectionId);
        allow delete: if isBusinessMember(businessId) && canDeleteTenantDocument(collectionId);
      }

      match /sales/{saleId}/items/{itemId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessMember(businessId) && hasMenuPermission('pos');
        allow update, delete: if isBusinessMember(businessId) && hasAdminPermission();
      }

      match /sales/{saleId}/payments/{paymentId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessMember(businessId) && (hasMenuPermission('pos') || hasMenuPermission('client-debts'));
        allow update, delete: if isBusinessMember(businessId) && hasAdminPermission();
      }
    }
  }
}
